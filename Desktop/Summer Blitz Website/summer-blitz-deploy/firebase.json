{
  "hosting": {
    "site": "stk-main-website",
    "public": ".",
    "ignore": [
      "firebase.json",
      "/.*"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/kill-shot.html",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
