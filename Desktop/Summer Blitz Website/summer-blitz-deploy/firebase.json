{
  "hosting": {
    "site": "stk-main-website",
    "public": ".",
    "ignore": [
      "firebase.json",
      "/.*",
      "**/.*",
      ".git/**",
      ".vscode/**",
      "**/firebase-debug.log",
      "tests/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/kill-shot.html",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }]
      },
      {
        "source": "/kill-shot.html",
        "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }]
      },
      {
        "source": "/social",
        "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }]
      },
      {
        "source": "/social/**",
        "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }]
      }
    ]
  }
}
